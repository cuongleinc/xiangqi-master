# ==========================================
# Xiangqi Master - Environment Variables
# ==========================================

# Node Environment
NODE_ENV=development

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=xiangqi
DATABASE_PASSWORD=xiangqi_dev
DATABASE_NAME=xiangqi
DATABASE_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Engine (Pikafish)
ENGINE_PATH=/usr/local/bin/pikafish
ENGINE_HASH=64
ENGINE_THREADS=1
ENGINE_TIMEOUT=60000

# Difficulty movetime settings (ms)
ENGINE_TIME_EASY=100
ENGINE_TIME_MEDIUM=500
ENGINE_TIME_HARD=1500
ENGINE_TIME_EXPERT=5000

# Move Classification Thresholds (centipawns)
CLASSIFICATION_BEST=20
CLASSIFICATION_EXCELLENT=50
CLASSIFICATION_GOOD=100
CLASSIFICATION_INACCURACY=200
CLASSIFICATION_MISTAKE=400

# Hint limits
HINTS_PER_GAME=3

# Frontend
VITE_API_URL=http://localhost:3000/api
